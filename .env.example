# Home ❤️ Cafe - Environment Variables
# Copy to .env.local for local development. Set in Vercel Project Settings for production.

# Secret 4 to 8 digit Admin PIN used by cashier/owner to log in to /admin
ADMIN_PIN=1234

# 32+ character random string used to sign session cookies
SESSION_SECRET=home-heart-cafe-super-secret-key-32chars-min-prod

# Application Timezone (Default: Asia/Manila)
TZ=Asia/Manila
